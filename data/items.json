  "note_uz":     {"name": "Записка на узбекском", "type": "note", "w": 0.01, "value": 0, "quest_item": true, "lang": "uz", "req": 3,
                  "orig": "Bochkalarni kecha kechasi «Podzemka»dan kelgan odamlar olib kelishdi. Ular ariqqa to'kishni buyurishdi. Pul berishdi. Bolalar kasal bo'lyapti. Meni kechiringlar. Lyuk kodi: to'rt — yetti — bir.",
                  "ru": "Бочки привезли вчера ночью люди из «Подземки». Приказали вылить в арык. Заплатили. Дети болеют. Простите меня. Код люка: четыре — семь — один.",
                  "on_pickup": ["quest_adv:well:2"], "on_read": ["flag:bunker_code", "quest_adv:well:3"],
                  "desc": "Клочок бумаги, исписанный латиницей."},
  "note_kk":     {"name": "Обрывок письма", "type": "note", "w": 0.01, "value": 0, "lang": "kk", "req": 2,
                  "orig": "Балам, суды қайнатпай ішпе. Құдықтың суы улы. Апаң.",
                  "ru": "Дитя моё, не пей воду, не вскипятив. Вода в колодце ядовитая. Твоя мама.",
                  "on_read": ["glossary:Балам", "glossary:Су", "glossary:Құдық"],
                  "desc": "Письмо, придавленное камнем на подоконнике."},
  "note_ru":     {"name": "Записка соседа", "type": "note", "w": 0.01, "value": 0, "lang": "ru", "req": 0,
                  "ru": "Серёга! Мы ушли в «Зарю», к Ерлану — там говорят, есть люди и вода. Ключа не оставляю, дверь не заперта. Если увидишь серых — не шуми, они идут на звук. Лопату взял я, извини. — Толик.",
                  "desc": "Прилеплена к двери хлебным мякишем."},
  "lab_journal": {"name": "Журнал лаборанта", "type": "note", "w": 0.3, "value": 0, "quest_item": true, "lang": "ru", "req": 0,
                  "ru": "12.06.99. Объект «Мелиорация-7» снова запросил очистку ёмкостей. Связи с Москвой и Алма-Атой нет с апреля. Майор приказал вывезти отходы штамма к насосной и слить в арык — «степь всё спишет». 03.07.99. Выброс на объекте. Облако идёт на север. Пыль. Люди меняются. У нас осталось 12 ампул ПФ-2. Майор запретил отдавать их колхозу. Я не согласен. Если кто-то это читает — объект в двух днях пути на юго-запад, у самой границы. Его надо закрыть.",
                  "on_pickup": ["quest_adv:bunker:2"],
                  "desc": "Общая тетрадь в клеёнчатой обложке."}
}
